# Copy to .env and fill in. Never commit .env.

# LLMs (OpenRouter)
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_PROVIDERS=Together,CoreWeave,Modal
# CLASSIFIER_MODEL defaults to LLM_MODEL

# X search (twitterapi.io)
TWITTERAPI_IO_KEY=

# Google search for Reddit threads (serper.dev; SerpAPI is the legacy v2 path)
SERPER_API_KEY=
SERPAPI_KEY=

# Residential proxy for Reddit comment fetches
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Sign-in: Firebase project whose ID tokens are accepted (web config is public by design)
# FIREBASE_PROJECT_ID=

# Abuse and spend guards
# RATE_LIMIT_PER_HOUR=30
# DAILY_SPEND_CAP_USD=25
# ANON_PER_IP_PER_DAY=3
# CACHE_TTL_HOURS=6
